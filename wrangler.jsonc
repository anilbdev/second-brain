{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "second-brain",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "second-brain-notes"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION",
        "class_name": "SessionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDO"]
    }
  ],
  "workflows": [
    {
      "name": "second-brain-ingest",
      "binding": "INGEST",
      "class_name": "IngestWorkflow"
    }
  ]
}
